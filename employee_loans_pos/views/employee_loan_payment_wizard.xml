<odoo>
    <record id="view_employee_loan_payment_wizard" model="ir.ui.view">
        <field name="name">employee.loan.payment.wizard.form</field>
        <field name="model">employee.loan.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar movimiento">
                <group>
                    <field name="loan_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="transaction_type"/>
                    <field name="date"/>
                    <field name="journal_id"/>
                    <field name="amount"/>
                    <field name="ref"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
