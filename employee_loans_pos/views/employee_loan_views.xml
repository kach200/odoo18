
<odoo>
    <record id="view_employee_loan_list" model="ir.ui.view">
        <field name="name">employee.loan.list</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="balance"/>
            </list>
        </field>
    </record>

    <record id="view_employee_loan_form" model="ir.ui.view">
        <field name="name">employee.loan.form</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="load_initial_balance"
                            type="object"
                            string="Cargar saldo inicial"
                            invisible="has_initial_balance"
                            class="btn-primary"/>
                    <button name="action_open_transaction_wizard"
                        type="object"
                        string="Registrar prestamo"
                        context="{'default_transaction_type': 'debit'}"
                        class="btn-secondary"/>
                    <button name="action_open_transaction_wizard"
                        type="object"
                        string="Registrar abono"
                        context="{'default_transaction_type': 'credit'}"
                        class="btn-secondary"/>
                    <button name="%(action_report_employee_loan_statement)d"
                            type="action"
                            string="Estado de cuenta"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id" readonly="id"/>
                        <field name="balance" readonly="1"/>
                        <field name="has_initial_balance" invisible="1"/>
                    </group>                    
                    <notebook>
                        <page string="Historial de movimientos">
                            <field name="line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="loan_amount"/>
                                    <field name="payment_amount"/>
                                    <field name="running_balance"/>
                                    <field name="type" optional="hide"/>
                                    <field name="amount" optional="hide"/>
                                    <field name="origin"/>
                                    <field name="journal_id"/>
                                    <field name="account_move_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_loan_kanban" model="ir.ui.view">
        <field name="name">employee.loan.kanban</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="employee_id"/>
                <field name="balance"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card_header d-flex align-items-center gap-3 p-3 border-bottom">
                            <field name="employee_id" widget="many2one_avatar" class="o_field_many2one_avatar"/>
                            <div class="o_kanban_card_header_title">
                                <div class="o_primary fw-bold">
                                    <field name="employee_id"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_kanban_card_content p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Saldo de deuda</span>
                                <span class="fw-bold text-primary fs-5">
                                    <field name="balance" widget="monetary"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_employee_loans" model="ir.actions.act_window">
        <field name="name">Prestamos Empleados</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_employee_loan_kanban"/>
    </record>

    <menuitem id="menu_employee_loans_root" name="Prestamos" parent="hr.menu_hr_root"/>
    <menuitem id="menu_employee_loans" name="Prestamos Empleados"
              parent="menu_employee_loans_root"
              action="action_employee_loans"/>
</odoo>
