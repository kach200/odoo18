
<odoo>
    <record id="view_employee_loan_wizard" model="ir.ui.view">
        <field name="name">employee.loan.wizard.form</field>
        <field name="model">employee.loan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="loan_id" invisible="1"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
