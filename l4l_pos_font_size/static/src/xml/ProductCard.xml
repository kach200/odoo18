<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//article/div[contains(@class, 'product-content')]" position="attributes">
            <attribute name="t-attf-style">
                font-size: {{CardFontSize()}}
            </attribute>
        </xpath>
    </t>
</templates>