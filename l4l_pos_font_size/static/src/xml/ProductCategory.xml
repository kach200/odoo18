<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.CategorySelector" t-inherit="point_of_sale.CategorySelector" t-inherit-mode="extension" owl="1">
        <xpath expr="//span[@t-if='category.name']" position="attributes">
            <attribute name="t-attf-style">
                font-size: {{CategoryFontSize()}}!important;
            </attribute>
        </xpath>
    </t>
</templates>