<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rc_generate_invoice_wizard_form" model="ir.ui.view">
        <field name="name">rc.generate.invoice.wizard.form</field>
        <field name="model">rc.generate.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar factura">
                <group>
                    <field name="batch_id" readonly="1"/>
                    <field name="partner_id"/>
                    <field name="journal_id"/>
                    <field name="invoice_date"/>
                </group>
                <footer>
                    <button name="action_generate_invoice" type="object" string="Generar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
