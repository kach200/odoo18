<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rc_invoice_batch_tree" model="ir.ui.view">
        <field name="name">rc.invoice.batch.tree</field>
        <field name="model">rc.invoice.batch</field>
        <field name="arch" type="xml">
            <list string="Lotes de facturacion">
                <field name="name"/>
                <field name="source_journal_id"/>
                <field name="target_journal_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="invoice_count"/>
            </list>
        </field>
    </record>

    <record id="view_rc_invoice_batch_form" model="ir.ui.view">
        <field name="name">rc.invoice.batch.form</field>
        <field name="model">rc.invoice.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de facturacion por diario">
                <header>
                    <button name="action_load_lines" type="object" string="Cargar productos" class="btn-primary"/>
                    <button
                        name="action_open_generate_wizard"
                        type="object"
                        string="Generar factura"
                        class="btn-primary"
                        invisible="not can_generate_invoice"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="source_journal_id"/>
                            <field name="target_journal_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="can_generate_invoice" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos vendidos">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id" readonly="1"/>
                                    <field name="quantity_sold" readonly="1"/>
                                    <field name="quantity_invoiced" readonly="1"/>
                                    <field name="quantity_available" readonly="1"/>
                                    <field name="quantity_to_invoice"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rc_invoice_batch" model="ir.actions.act_window">
        <field name="name">Facturacion por Diario</field>
        <field name="res_model">rc.invoice.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rc_invoice_batch_root" name="Facturacion por Diario" parent="account.menu_finance" sequence="90"/>
    <menuitem id="menu_rc_invoice_batch" name="Lotes" parent="menu_rc_invoice_batch_root" action="action_rc_invoice_batch" sequence="1"/>
</odoo>
